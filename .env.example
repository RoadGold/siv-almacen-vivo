# --- Base de datos -----------------------------------------------------------
POSTGRES_USER=siv
POSTGRES_PASSWORD=siv
POSTGRES_DB=siv_almacen_vivo
DATABASE_URL=postgresql+psycopg://siv:siv@127.0.0.1:5432/siv_almacen_vivo

# --- Aplicacion --------------------------------------------------------------
ENVIRONMENT=local
SECRET_KEY=cambia-esta-clave-en-produccion-local
ACCESS_TOKEN_EXPIRE_MINUTES=480
NOMBRE_NEGOCIO=Almacén Vivo
MONEDA=S/
TIMEZONE=America/Lima
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# --- Impresora de tickets (ESC/POS por red) ---------------------------------
# La direccion IP y el puerto se confirman con scripts\pruebas\probar-impresora.ps1
IMPRESORA_ACTIVA=false
IMPRESORA_HOST=127.0.0.1
IMPRESORA_PUERTO=9100
IMPRESORA_COLUMNAS=48
IMPRESORA_CORTAR=true
IMPRESORA_QR=true
IMPRESORA_PAGINA_CODIGO=2
IMPRESORA_TIEMPO_LIMITE=8

# --- Datos de la instalacion inicial (usados por scripts/instalar) ------------
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambiar-esta-clave
ADMIN_NOMBRE=Administrador
